{
  "info": {
    "name": "Smart Lead Intake API",
    "description": "Test cases for the BuildShip lead-intake workflow. For the AI-failure case, point Classify Lead's API key at a wrong value and re-run case 2 (expect priority 'unscored').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://3zhkbl.buildship.run"
    }
  ],
  "item": [
    {
      "name": "1. Clear buying intent",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('has leadId and priority', () => { const j = pm.response.json(); pm.expect(j.leadId).to.match(/^L-\\d+$/); pm.expect(['hot','warm','cold','unscored']).to.include(j.priority); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sara Ahmed\",\n  \"email\": \"sara@acme.com\",\n  \"company\": \"Acme Ltd\",\n  \"message\": \"We need a chatbot for our store, budget ready, want to start this month.\",\n  \"source\": \"website-contact-form\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/leadIntake",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "leadIntake"
          ]
        },
        "description": "Expected: 200, priority hot, Slack + email alert, row saved"
      }
    },
